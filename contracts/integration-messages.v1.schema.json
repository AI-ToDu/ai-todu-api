        },
        "version": {
          "const": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "required": [
            "dispatchId"
          ],
          "additionalProperties": false,
          "properties": {
            "dispatchId": {
              "type": "string",
              "format": "uuid"
