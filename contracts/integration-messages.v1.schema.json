            },
            "minimum": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "eventId",
        "tenantId",
        "type",
        "version",
        "occurredAt",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "sales.sale-confirmed"
        },
        "version": {
          "const": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "required": [
            "saleId",
            "totalCents",
            "currency"
          ],
          "additionalProperties": false,
          "properties": {
            "saleId": {
